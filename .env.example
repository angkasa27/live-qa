# Postgres. Anything that speaks the wire protocol — local, Neon, or the Postgres in your
# Coolify/Dokploy stack. Nothing here is host-specific.
#
# The app's own traffic. On Neon this is the POOLED host — the one with `-pooler` in it.
DATABASE_URL=postgres://user@127.0.0.1:5432/sual_dev

# Only needed where a connection pooler sits in front of Postgres, which on Neon means always.
# Same string with `-pooler` removed from the host. Schema migrations and better-auth's migrator
# use this: PgBouncer runs in transaction mode and drops the session state they depend on.
# Leave it blank for a plain local Postgres; there's no pooler to bypass.
DATABASE_URL_UNPOOLED=

# better-auth. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Required in production — the origin check compares against it. Leave unset in development
# so it's inferred from the request, because next dev's port moves when 3000 is taken.
BETTER_AUTH_URL=

# Salt for the rate-limit IP hash, so raw addresses are never stored. Same generator as above.
IP_HASH_SALT=

# Gemini, for "Ambil jawaban dari rekaman" on the admin event board: it reads the majelis
# recording and proposes drafts for questions still unanswered. Optional — leave it blank and the
# button reports that it is unset; every answer is still typed by hand as before.
#
# The recording must be PUBLIC on YouTube. Gemini rejects unlisted and private URLs outright.
# Free tier allows 8 hours of YouTube video per day.
GEMINI_API_KEY=
