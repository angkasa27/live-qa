# Postgres. Anything that speaks the wire protocol — local, Neon, or the Postgres in your
# Coolify/Dokploy stack. Nothing here is host-specific.
DATABASE_URL=postgres://user@127.0.0.1:5432/ask_dev

# better-auth. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Required in production — the origin check compares against it. Leave unset in development
# so it's inferred from the request, because next dev's port moves when 3000 is taken.
BETTER_AUTH_URL=

# Salt for the rate-limit IP hash, so raw addresses are never stored. Same generator as above.
IP_HASH_SALT=
